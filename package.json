{
  "name": "iwork-mcp",
  "version": "0.8.7",
  "description": "MCP server for Apple iWork automation — 117 tools for Numbers, Pages, and Keynote",
  "license": "MIT",
  "type": "module",
  "bin": {
    "iwork-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "screenshots"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "node --import tsx --test test/registration.test.ts test/jxa.test.ts",
    "test:integration": "node --import tsx --test test/numbers.test.ts test/pages.test.ts test/keynote.test.ts",
    "test:all": "node --import tsx --test test/**/*.test.ts",
    "sync-counts": "node --import tsx scripts/sync-tool-counts.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "iwork",
    "numbers",
    "pages",
    "keynote",
    "apple",
    "jxa",
    "automation",
    "spreadsheet",
    "presentation",
    "claude"
  ]
}
